      "bgImage": ""
    },
    {
      "id": 22,
      "type": "text",
      "x": 790,
      "y": 200,
      "width": 350,
      "height": 110,
      "flipped": false,
      "text": "Reset, Set, and Flip-Flop Switches.\n\nIf you do not implement a workaround\n (delaying certain circuits using a crystal oscillator),\nchattering is highly likely to occur.\n",
      "fontSize": 13,
      "bgColor": "#2b3a4a",
      "bgImage": ""
    },
